# Copy to /home/ubuntu/apps/downloadknowledge/.env and chmod 600.

# argon2id hash of the account password. Generate it with:
#   docker run --rm -i ghcr.io/felixlabsdev/downloadknowledge:latest dk hash-password <<< 'the password'
# Keep the single quotes: the hash contains $ characters.
DK_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$...'

# Port on localhost that Caddy proxies to. Check it is free first: ss -ltn | grep 5180
DK_PORT=5180

# Image tag. "latest" follows main. Set a commit sha to roll back and pin.
DK_TAG=latest

# S3 bucket for nightly backups (no s3:// prefix). Leave empty to keep backups on the server only.
DK_BACKUP_BUCKET=
